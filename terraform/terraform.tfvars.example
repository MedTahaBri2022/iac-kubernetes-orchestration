# Copy to terraform.tfvars (ignored by git) and adjust.

environment = "dev"
region      = "eu-west-3"

# Your public IP, as a /32. Find it with: curl https://checkip.amazonaws.com
admin_cidr = "203.0.113.7/32"

# Contents of ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

instance_type = "t3.small"
